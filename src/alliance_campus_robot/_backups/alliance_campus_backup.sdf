        <collision name="collision">

          <geometry>
            <box>
              <size>100 80 0.2</size>
            </box>
          </geometry>

        </collision>

        <visual name="visual">

          <geometry>
            <box>
              <size>100 80 0.2</size>
            </box>
          </geometry>

          <material>

            <ambient>0.32 0.48 0.28 1</ambient>

            <diffuse>0.32 0.48 0.28 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


