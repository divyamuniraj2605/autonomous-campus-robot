<?xml version="1.0"?>
<robot name="campus_ugv">

  <!-- ================= BASE ================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.65 0.25"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.65 0.25"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.5"
        ixy="0.0"
        ixz="0.0"
        iyy="0.8"
        iyz="0.0"
        izz="1.0"/>
    </inertial>

  </link>


  <!-- ================= UPPER PLATFORM ================= -->

  <link name="upper_platform">

    <visual>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.50 0.10"/>
      </geometry>
      <material name="dark_blue">
        <color rgba="0.0 0.15 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.50 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.40" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.05"
        ixy="0.0"
        ixz="0.0"
        iyy="0.08"
        iyz="0.0"
        izz="0.10"/>
    </inertial>

  </link>

  <joint name="upper_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_platform"/>
  </joint>


  <!-- ================= FRONT LEFT WHEEL ================= -->

  <link name="front_left_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.30 0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================= FRONT RIGHT WHEEL ================= -->

  <link name="front_right_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.30 -0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================= REAR LEFT WHEEL ================= -->

  <link name="rear_left_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.30 0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================= REAR RIGHT WHEEL ================= -->

  <link name="rear_right_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.30 -0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ================= LIDAR ================= -->

  <link name="laser_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.08"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.52" rpy="0 0 0"/>
  </joint>


  <!-- ================= GAZEBO LIDAR ================= -->

  <gazebo reference="laser_link">

    <sensor name="lidar_sensor" type="ray">

      <visualize>true</visualize>

      <pose>0 0 0 0 0 0</pose>

      <update_rate>10</update_rate>

      <ray>

        <scan>

          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>

        </scan>

        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>

      </ray>

      <plugin
        name="gazebo_ros_laser"
        filename="libgazebo_ros_ray_sensor.so">

        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>

        <frame_name>laser_link</frame_name>

      </plugin>

    </sensor>

  </gazebo>


  <!-- ================= DIFFERENTIAL DRIVE ================= -->

  <gazebo>

    <plugin
      name="skid_steer_drive"
      filename="libgazebo_ros_diff_drive.so">

      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>

      <update_rate>50</update_rate>

      <!-- ONLY FRONT WHEELS ARE DRIVE WHEELS -->

      <num_wheel_pairs>1</num_wheel_pairs>

      <left_joint>front_left_wheel_joint</left_joint>

      <right_joint>front_right_wheel_joint</right_joint>

      <wheel_separation>0.76</wheel_separation>
      <wheel_diameter>0.30</wheel_diameter>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

    </plugin>

  </gazebo>

</robot>
