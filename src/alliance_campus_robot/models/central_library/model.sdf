<?xml version="1.0"?>

<sdf version="1.9">

  <model name="central_library">

    <static>true</static>

    <pose>-20 3 0 0 0 0</pose>


    <!-- ================================================= -->
    <!-- MAIN LIBRARY BUILDING -->
    <!-- ================================================= -->

    <link name="library_body">

      <collision name="body_collision">

        <pose>0 0 2 0 0 0</pose>

        <geometry>

          <cylinder>

            <radius>6</radius>

            <length>4</length>

          </cylinder>

        </geometry>

      </collision>


      <visual name="body_visual">

        <pose>0 0 2 0 0 0</pose>

        <geometry>

          <cylinder>

            <radius>6</radius>

            <length>4</length>

          </cylinder>

        </geometry>


        <material>

          <ambient>0.72 0.58 0.38 1</ambient>

          <diffuse>0.72 0.58 0.38 1</diffuse>

          <specular>0.2 0.2 0.2 1</specular>

        </material>

      </visual>

    </link>


    <!-- ================================================= -->
    <!-- DOME -->
    <!-- ================================================= -->

    <link name="library_dome">

      <visual name="dome">

        <pose>0 0 5.0 0 0 0</pose>

        <geometry>

          <sphere>

            <radius>5.2</radius>

          </sphere>

        </geometry>


        <material>

          <ambient>0.70 0.78 0.88 1</ambient>

          <diffuse>0.70 0.78 0.88 1</diffuse>

          <specular>0.8 0.8 0.8 1</specular>

        </material>

      </visual>

    </link>


    <!-- ================================================= -->
    <!-- DOME CAP -->
    <!-- ================================================= -->

    <link name="dome_cap">

      <visual name="cap">

        <pose>0 0 9.8 0 0 0</pose>

        <geometry>

          <cylinder>

            <radius>0.7</radius>

            <length>0.35</length>

          </cylinder>

        </geometry>


        <material>

          <ambient>0.25 0.30 0.38 1</ambient>

          <diffuse>0.25 0.30 0.38 1</diffuse>

        </material>

      </visual>

    </link>


    <!-- ================================================= -->
    <!-- FRONT GLASS ENTRANCE -->
    <!-- ================================================= -->

    <link name="front_entrance">

      <collision name="entrance_collision">

        <pose>0 -6.05 1.5 0 0 0</pose>

