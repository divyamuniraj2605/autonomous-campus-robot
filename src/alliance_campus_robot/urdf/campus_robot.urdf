<?xml version="1.0"?>
<robot name="campus_ugv">

  <!-- ==================== BASE ==================== -->

  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="18.0"/>
      <inertia
        ixx="1.2"
        ixy="0"
        ixz="0"
        iyy="1.6"
        iyz="0"
        izz="2.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.65 0.25"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.25 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.65 0.25"/>
      </geometry>
    </collision>

  </link>


  <!-- ==================== FRONT LEFT WHEEL ==================== -->

  <link name="front_left_wheel">

    <inertial>
      <mass value="0.7"/>
      <inertia
        ixx="0.02"
        ixy="0"
        ixz="0"
        iyy="0.02"
        iyz="0"
        izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.30 0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== FRONT RIGHT WHEEL ==================== -->

  <link name="front_right_wheel">

    <inertial>
      <mass value="0.7"/>
      <inertia
        ixx="0.02"
        ixy="0"
        ixz="0"
        iyy="0.02"
        iyz="0"
        izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.30 -0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== REAR LEFT WHEEL ==================== -->

  <link name="rear_left_wheel">

    <inertial>
      <mass value="0.7"/>
      <inertia
        ixx="0.02"
        ixy="0"
        ixz="0"
        iyy="0.02"
        iyz="0"
        izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.30 0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== REAR RIGHT WHEEL ==================== -->

  <link name="rear_right_wheel">

    <inertial>
      <mass value="0.7"/>
      <inertia
        ixx="0.02"
        ixy="0"
        ixz="0"
        iyy="0.02"
        iyz="0"
        izz="0.03"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.12"/>
      </geometry>
    </collision>

  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.30 -0.38 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- ==================== UPPER PLATFORM ==================== -->

  <link name="upper_platform">

    <visual>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.45 0.08"/>
      </geometry>
      <material name="platform_blue">
        <color rgba="0.0 0.35 1.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.45 0.08"/>
      </geometry>
    </collision>

  </link>

  <joint name="upper_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="upper_platform"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- ==================== LIDAR ==================== -->

  <link name="laser_link">

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <material name="yellow">
        <color rgba="1.0 1.0 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
    </collision>

  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0.52" rpy="0 0 0"/>
  </joint>


  <!-- ==================== GAZEBO LIDAR ==================== -->

  <gazebo reference="laser_link">

    <sensor name="lidar_sensor" type="ray">

      <pose>0 0 0 0 0 0</pose>

      <update_rate>10</update_rate>

      <ray>

        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>

      </ray>

      <plugin
        name="gazebo_ros_laser"
        filename="libgazebo_ros_ray_sensor.so">

        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>

        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>

      </plugin>

      <visualize>true</visualize>

    </sensor>

  </gazebo>


  <!-- ==================== WHEEL FRICTION (reduces skid-steer slip) ==================== -->

  <gazebo reference="front_left_wheel">
    <mu1>1.0</mu1>
    <mu2>0.2</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="front_right_wheel">
    <mu1>1.0</mu1>
    <mu2>0.2</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1>
    <mu2>0.2</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1>
    <mu2>0.2</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- ==================== GROUND TRUTH POSE (simulation only) ==================== -->
  <gazebo>
    <plugin name="ground_truth_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>30.0</update_rate>
    </plugin>
  </gazebo>

  <!-- ==================== 4-WHEEL DIFFERENTIAL DRIVE ==================== -->

  <gazebo>

    <plugin
      name="skid_steer_drive"
      filename="libgazebo_ros_diff_drive.so">

      <update_rate>50</update_rate>

      <!-- TWO LEFT/RIGHT WHEEL PAIRS -->
      <num_wheel_pairs>2</num_wheel_pairs>

      <!-- FRONT PAIR -->
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>

      <!-- REAR PAIR -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- KINEMATICS -->
      <wheel_separation>0.76</wheel_separation>
      <wheel_diameter>0.30</wheel_diameter>

      <!-- LIMITS -->
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>10</max_wheel_acceleration>
      <max_linear_velocity>2.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <!-- ROS TOPICS -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

    </plugin>

  </gazebo>

</robot>
